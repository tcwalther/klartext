---
import Layout from '../layouts/Layout.astro';
import { getFragen, frageUrl } from '../lib/content';
import { buchstabe } from '../lib/optionen';

const fragen = await getFragen();
// Beispiel: eine Frage mit Kurzfassung, sonst die erste
const beispiel = fragen.find((f) => f.data.kurzfrage) ?? fragen[0]!;
const stufen = [
  { t: 'Die Frage', z: '10 Sekunden' },
  { t: 'Kurz erklärt', z: '30 Sekunden' },
  { t: 'Verstehen', z: '10 Minuten' },
  { t: 'Genau wissen', z: 'so lange du willst' },
];
---

<Layout>
  <section class="mx-auto max-w-5xl px-4 pt-12 sm:pt-20">
    <h1 class="text-[2.4rem] sm:text-6xl font-bold leading-[1.05] tracking-tight max-w-3xl">
      Politik verstehen, bevor man sie bewertet
    </h1>
    <p class="mt-5 text-lg sm:text-xl text-muted max-w-xl">
      Einfache Fragen zur Gesundheitspolitik. Wer unsicher ist, bekommt eine kurze Erklärung und kann so tief
      einsteigen, wie er möchte.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href="/gesundheit/fragen/" class="btn btn-primary">Erste Frage beantworten</a>
      <a href="/gesundheit/" class="link font-semibold">Alle Fragen ansehen</a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 mt-16 sm:mt-24" aria-label="So funktioniert es">
    <ol class="grid grid-cols-2 lg:grid-cols-4 border-t-2 border-ink">
      {
        stufen.map((s, i) => (
          <li class="pt-3 pb-5 pr-4">
            <span class="block text-3xl font-bold tabular-nums">{i + 1}</span>
            <span class="block font-bold mt-1">{s.t}</span>
            <span class="block text-sm text-muted">{s.z}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-5xl px-4 mt-12" aria-labelledby="beispiel">
    <h2 id="beispiel" class="kicker mb-3">Zum Beispiel</h2>
    <a href={frageUrl(beispiel.id)} class="group block max-w-2xl border-2 border-ink p-5 sm:p-6 no-underline hover:bg-surface-2">
      <span class="block text-xl sm:text-2xl font-bold leading-snug">{beispiel.data.kurzfrage ?? beispiel.data.titel}</span>
      <span class="mt-4 grid gap-2">
        {
          beispiel.data.optionen.map((o, i) => (
            <span class="flex items-center gap-3">
              <span class="opt">{buchstabe(i)}</span>
              {o.titel}
            </span>
          ))
        }
      </span>
      <span class="mt-5 inline-block font-semibold underline underline-offset-4 decoration-2 group-hover:no-underline">Zur Frage</span>
    </a>
  </section>

</Layout>
