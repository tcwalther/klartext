---
import Layout from '../layouts/Layout.astro';
import ClaimBadge from '../components/ClaimBadge.astro';
import { getFragen } from '../lib/content';

const fragen = await getFragen();
const beispiel = fragen.find((f) => f.id === 'krankenhaus-standorte') ?? fragen[0];
const schichten = [
  { n: 0, t: 'Die Frage', d: 'Kurz und einfach, wie beim Wahl-O-Mat.' },
  { n: 1, t: 'Worum geht’s?', d: 'Das Wichtigste in zwei Minuten.' },
  { n: 2, t: 'Argumente & Zielkonflikte', d: 'Die stärksten Gründe für jede Option – und was sie kostet.' },
  { n: 3, t: 'Fakten & Daten', d: 'Zahlen mit Quelle und Stand.' },
  { n: 4, t: 'Geschichte', d: 'Was wurde schon versucht, was kam heraus?' },
  { n: 5, t: 'Andere Länder', d: 'Wie machen es andere – und ist das übertragbar?' },
];
---

<Layout>
  <section class="mx-auto max-w-5xl px-4 pt-10 sm:pt-20 pb-6">
    <h1 class="serif text-4xl sm:text-6xl font-semibold leading-[1.08] max-w-3xl">
      Erst verstehen.<br />Dann entscheiden.
    </h1>
    <p class="mt-6 text-lg sm:text-xl text-muted max-w-2xl leading-relaxed">
      Beim Wahl-O-Mat hat man zu vielen Fragen keine Meinung – weil man nicht weiß, worum es geht. Klartext fängt genauso
      einfach an. Aber wenn du sagst <em class="text-ink not-italic font-semibold">„kann ich nicht entscheiden“</em>,
      geht es Schicht für Schicht tiefer: Argumente, Daten, Geschichte, andere Länder.
    </p>
    <div class="mt-8 flex flex-wrap gap-2">
      <a href="/gesundheit/" class="btn btn-primary">Mit dem Gesundheitssystem beginnen →</a>
      <a href="/methodik/" class="btn btn-ghost">Wie neutral ist das?</a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 mt-12 grid lg:grid-cols-2 gap-10 items-start">
    <div>
      <h2 class="serif text-2xl font-semibold">Wie eine Zwiebel</h2>
      <p class="text-muted mt-2 mb-5 max-w-prose">
        Jede Frage hat mehrere Schichten. Du gehst nur so tief, wie du willst. Alle sehen dieselben Inhalte – es gibt
        keine personalisierten Antworten.
      </p>
      <ol class="grid gap-1.5">
        {
          schichten.map((s, i) => (
            <li
              class="card flex items-center gap-3 py-2.5 pr-3"
              style={`margin-left: ${i * 0.75}rem; padding-left: 0.75rem`}
            >
              <span class="size-7 shrink-0 rounded-full grid place-items-center text-xs font-semibold" style={`background: color-mix(in srgb, var(--accent) ${100 - i * 15}%, var(--surface)); color: ${i < 3 ? 'var(--accent-ink)' : 'var(--ink)'}`}>
                {s.n}
              </span>
              <span class="min-w-0">
                <span class="block font-semibold leading-snug">{s.t}</span>
                <span class="block text-sm text-muted leading-snug">{s.d}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <div>
      <h2 class="serif text-2xl font-semibold">Daten und Meinungen getrennt</h2>
      <p class="text-muted mt-2 mb-5 max-w-prose">
        Jede Aussage trägt ein Etikett. So siehst du sofort, ob etwas belegt ist, geschätzt wird, eine Abwägung ist –
        oder ob es jemand fordert, der ein Interesse daran hat.
      </p>
      <ul class="card divide-y divide-[var(--line)]">
        <li class="p-4"><ClaimBadge typ="fakt" /><span class="ml-2">Überprüfbare Tatsache – immer mit Quelle.</span></li>
        <li class="p-4"><ClaimBadge typ="schaetzung" /><span class="ml-2">Prognose oder Studienergebnis mit Unsicherheit.</span></li>
        <li class="p-4"><ClaimBadge typ="wertung" /><span class="ml-2">Argument, das auf einer Abwägung beruht.</span></li>
        <li class="p-4"><ClaimBadge typ="position" wer="Verband X" /><span class="ml-2">Was ein bestimmter Akteur fordert.</span></li>
      </ul>
      {
        beispiel && (
          <a href={`/gesundheit/${beispiel.id}/`} class="card block p-4 mt-4 no-underline hover:border-faint">
            <span class="text-xs font-semibold uppercase tracking-wide text-faint">Beispiel ansehen</span>
            <span class="block serif text-lg font-semibold mt-1 leading-snug">{beispiel.data.titel}</span>
            <span class="block text-sm text-muted mt-0.5">{beispiel.data.frage}</span>
          </a>
        )
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 mt-16">
    <div class="card p-6 sm:p-8 grid sm:grid-cols-3 gap-6">
      <div>
        <h3 class="font-semibold">Neutral</h3>
        <p class="text-sm text-muted mt-1">
          Keine Wahlempfehlung, kein Ranking. Jede Option wird in ihrer stärksten Form dargestellt.
        </p>
      </div>
      <div>
        <h3 class="font-semibold">Belegt</h3>
        <p class="text-sm text-muted mt-1">
          Jede Zahl hat eine Quelle. Jede Änderung ist öffentlich nachvollziehbar.
        </p>
      </div>
      <div>
        <h3 class="font-semibold">Privat</h3>
        <p class="text-sm text-muted mt-1">
          Deine Antworten bleiben in deinem Browser. Kein Konto, kein Tracking deiner Meinung.
        </p>
      </div>
    </div>
  </section>
</Layout>
