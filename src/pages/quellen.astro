---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getFragen, frageUrl, type Quelle } from '../lib/content';

const fragen = await getFragen();
const system = await getCollection('system');

// Quellen über alle Fragen zusammenführen (gleiche URL oder gleicher Titel = gleiche Quelle)
type Eintrag = Quelle & { verwendet: { titel: string; url: string }[] };
const alle = new Map<string, Eintrag>();
const add = (q: Quelle, titel: string, url: string) => {
  const key = (q.url ?? q.titel).toLowerCase();
  const e = alle.get(key) ?? { ...q, verwendet: [] };
  if (!e.verwendet.some((v) => v.url === url)) e.verwendet.push({ titel, url });
  alle.set(key, e);
};
for (const f of fragen) for (const q of f.data.quellen) add(q, f.data.titel, `${frageUrl(f.id)}#quelle-${q.id}`);
for (const s of system) for (const q of s.data.quellen) add(q, 'Systemkarte Gesundheit', `/gesundheit/#quelle-${q.id}`);

const gruppen = [
  ['amtlich', 'Amtliche Statistik'],
  ['gesetz', 'Gesetze & Drucksachen'],
  ['gutachten', 'Gutachten'],
  ['wissenschaft', 'Wissenschaft'],
  ['international', 'Internationale Organisationen'],
  ['verband', 'Verbände & Interessenträger'],
  ['partei', 'Parteien'],
  ['presse', 'Presse'],
] as const;
const sortiert = [...alle.values()].sort((a, b) => a.herausgeber.localeCompare(b.herausgeber, 'de') || b.jahr - a.jahr);
---

<Layout title="Quellen" description="Alle Quellen, auf die sich Klartext stützt.">
  <div class="mx-auto max-w-3xl px-4 pt-6 sm:pt-10">
    <h1 class="serif text-3xl sm:text-4xl font-semibold">Quellen</h1>
    <p class="mt-3 text-muted">{alle.size} Quellen, nach Art geordnet. Zu jeder Quelle ist angegeben, wo sie verwendet wird.</p>

    {
      gruppen.map(([art, titel]) => {
        const qs = sortiert.filter((q) => q.art === art);
        if (!qs.length) return null;
        return (
          <section class="mt-10">
            <h2 class="serif text-xl font-semibold mb-3">
              {titel} <span class="text-faint font-normal text-base">({qs.length})</span>
            </h2>
            <ul class="grid gap-3">
              {qs.map((q) => (
                <li class="text-[0.95rem]">
                  {q.url ? (
                    <a class="link" href={q.url} target="_blank" rel="noopener">
                      {q.titel}
                    </a>
                  ) : (
                    q.titel
                  )}
                  <span class="text-muted">
                    {' '}
                    – {q.herausgeber}, {q.jahr}
                  </span>
                  <span class="block text-xs text-faint mt-0.5">
                    Verwendet in:{' '}
                    {q.verwendet.map((v, i) => (
                      <>
                        {i > 0 && ' · '}
                        <a href={v.url} class="hover:text-ink underline underline-offset-2">
                          {v.titel}
                        </a>
                      </>
                    ))}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>
</Layout>
