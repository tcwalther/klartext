---
import Layout from '../layouts/Layout.astro';
import MeinBild from '../islands/MeinBild.tsx';
import { getFragen, getBereiche, getSpannungen, frageKurz } from '../lib/content';

const fragen = (await getFragen()).map(frageKurz);
const bereiche = (await getBereiche()).map((b) => ({ id: b.id, titel: b.data.titel }));
const spannungen = await getSpannungen();
---

<Layout title="Mein Bild" description="Deine Antworten, offenen Fragen und Zielkonflikte, gespeichert nur in deinem Browser.">
  <div class="mx-auto max-w-3xl px-4 pt-6 sm:pt-10">
    <header class="mb-6">
      <h1 class="serif text-3xl sm:text-4xl font-semibold">Mein Bild</h1>
      <p class="mt-2 text-muted max-w-prose">
        Eine Übersicht deiner Antworten: wo du dich festgelegt hast, wo du noch offen bist und wo deine Antworten in
        verschiedene Richtungen ziehen. Klartext gibt keine Wahlempfehlung und vergibt keine Punkte.
      </p>
    </header>
    <MeinBild client:load fragen={fragen} bereiche={bereiche} spannungen={spannungen} />
  </div>
</Layout>
