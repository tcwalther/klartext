---
/**
 * Themenseite Gesundheit.
 * Aufbau nach dem Zwiebel-Prinzip: erst das mentale Modell (wenige merkbare Aussagen),
 * dann die Fragen, dann wie das System funktioniert – und alle Detailzahlen nur auf Wunsch.
 */
import Layout from '../../layouts/Layout.astro';
import Kennzahl from '../../components/Kennzahl.astro';
import SourceRefs from '../../components/SourceRefs.astro';
import AussageListe from '../../components/AussageListe.astro';
import EntwurfHinweis from '../../components/EntwurfHinweis.astro';
import { getCollection } from 'astro:content';
import { getFragen, getBereiche, frageUrl, ebenenVon } from '../../lib/content';

const bereiche = await getBereiche();
const fragen = await getFragen();
const system = (await getCollection('system')).find((s) => s.id === 'gesundheit');
const sd = system?.data;

// Quellen in der Reihenfolge ihres Auftretens auf der Seite nummerieren
const nums = new Map<string, number>();
const merke = (id: string) => !nums.has(id) && nums.set(id, nums.size + 1);
if (sd) {
  sd.kernaussagen.forEach((a) => a.quellen.forEach(merke));
  if (sd.ausgabenanteile) merke(sd.ausgabenanteile.quelle);
  sd.kennzahlen.forEach((k) => merke(k.quelle));
  sd.geldfluss.forEach((g) => merke(g.quelle));
  sd.quellen.forEach((q) => merke(q.id));
}
const quellenSortiert = [...(sd?.quellen ?? [])].sort((a, b) => nums.get(a.id)! - nums.get(b.id)!);

const anteile = sd?.ausgabenanteile;
const anteilSumme = anteile ? anteile.anteile.reduce((s, a) => s + a.wert, 0) : 0;
const fmt = new Intl.NumberFormat('de-DE', { maximumFractionDigits: 1 });
// Abgestufte Töne derselben Akzentfarbe – keine Parteifarben, „Alles andere“ grau
const toene = [
  'var(--accent)',
  'color-mix(in srgb, var(--accent) 70%, var(--bg))',
  'color-mix(in srgb, var(--accent) 45%, var(--bg))',
  'var(--line)',
];

// Zusammenhänge zwischen Bereichen aus den Verknüpfungen der Fragen ableiten
const bereichVon = new Map(fragen.map((f) => [f.id, f.data.bereich]));
const kanten = new Map<string, number>();
for (const f of fragen) {
  for (const v of f.data.verknuepft) {
    const a = f.data.bereich;
    const b = bereichVon.get(v.frage);
    if (!b || a === b) continue;
    const key = [a, b].sort().join('|');
    kanten.set(key, (kanten.get(key) ?? 0) + 1);
  }
}
const R = 140;
const pos = new Map(
  bereiche.map((b, i) => {
    const w = (i / bereiche.length) * Math.PI * 2 - Math.PI / 2;
    return [b.id, { x: 200 + R * Math.cos(w), y: 200 + R * Math.sin(w), w }];
  }),
);
const maxKante = Math.max(1, ...kanten.values());
const verbindungen = (id: string) => [...kanten.entries()].filter(([k]) => k.split('|').includes(id)).reduce((s, [, n]) => s + n, 0);
---

<Layout title="Gesundheit" description="Das deutsche Gesundheitssystem verständlich: das Wichtigste auf einen Blick, die großen Fragen und wie das System funktioniert.">
  <div class="mx-auto max-w-5xl px-4 pt-6 sm:pt-10">
    <header class="max-w-3xl">
      <h1 class="serif text-4xl sm:text-5xl font-semibold leading-tight">Gesundheit</h1>
      <p class="mt-4 text-lg text-muted leading-relaxed">
        Kaum eine Frage im Gesundheitssystem lässt sich für sich allein beantworten. Wer mehr Kliniken in der Nähe will,
        muss sagen, wie sie bezahlt werden sollen; wer niedrigere Beiträge will, muss sagen, wo gespart werden soll.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href="/gesundheit/fragen/" class="btn btn-primary">Fragen starten ({fragen.length}) →</a>
      </div>
    </header>

    {
      sd && sd.kernaussagen.length > 0 && (
        <section class="mt-14 max-w-3xl" aria-labelledby="blick">
          <h2 id="blick" class="serif text-2xl font-semibold mb-5">
            Das Wichtigste auf einen Blick
          </h2>
          <AussageListe items={sd.kernaussagen} nums={nums} class="text-[1.05rem] space-y-5" />
        </section>
      )
    }

    <!-- Die Fragen -->
    <section id="bereiche" class="mt-16 scroll-mt-20" aria-labelledby="bereiche-h">
      <h2 id="bereiche-h" class="serif text-2xl font-semibold mb-6">Die Fragen</h2>
      <div class="grid md:grid-cols-2 gap-x-10 gap-y-10">
        {
          bereiche.map((b) => {
            const fs = fragen.filter((f) => f.data.bereich === b.id);
            return (
              <section id={`bereich-${b.id}`} class="border-t-2 border-ink pt-3 scroll-mt-20">
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="serif text-xl font-semibold">{b.data.titel}</h3>
                  {fs.length > 0 && (
                    <a href={`/gesundheit/fragen/?bereich=${b.id}`} class="text-sm link shrink-0">
                      Fragen starten
                    </a>
                  )}
                </div>
                <div class="mb-2" />
                {fs.length === 0 ? (
                  <p class="text-sm text-faint italic">In Arbeit.</p>
                ) : (
                  <ul class="border-t border-line">
                    {fs.map((f) => {
                      const tiefe = ebenenVon(f).filter((e) => e.da && e.n < 7).length;
                      return (
                        <li class="border-b border-line">
                          <a href={frageUrl(f.id)} class="group flex items-start gap-3 py-2.5 no-underline">
                            <span class="flex-1 leading-snug group-hover:text-accent">{f.data.titel}</span>
                            <span
                              class="flex gap-0.5 pt-1.5 shrink-0"
                              title={`${tiefe} von 6 Ebenen ausgearbeitet`}
                              aria-label={`${tiefe} von 6 Ebenen ausgearbeitet`}
                            >
                              {[1, 2, 3, 4, 5, 6].map((n) => (
                                <span class="size-1.5 rounded-full" style={`background: ${n <= tiefe ? 'var(--accent)' : 'var(--line)'}`} />
                              ))}
                            </span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                )}
              </section>
            );
          })
        }
      </div>
    </section>

    <!-- Wie das System funktioniert -->
    {
      sd && (
        <section class="mt-20" aria-labelledby="system">
          <h2 id="system" class="serif text-2xl font-semibold mb-8">
            Wie das System funktioniert
          </h2>

          {anteile && (
            <figure class="mb-14">
              <figcaption class="mb-4">
                <span class="block serif text-xl font-semibold">{anteile.titel}</span>
              </figcaption>
              <div
                class="flex h-9 sm:h-11 rounded-md overflow-hidden gap-0.5"
                role="img"
                aria-label={anteile.anteile.map((a) => `${a.label}: ${a.text}`).join('; ')}
              >
                {anteile.anteile.map((a, i) => (
                  <div
                    style={`flex: ${a.wert}; background: ${toene[Math.min(i, toene.length - 1)]}`}
                    title={`${a.label}: ${fmt.format(a.wert)} ${anteile.einheit}`}
                  />
                ))}
              </div>
              <ul class="mt-4 grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-4">
                {anteile.anteile.map((a, i) => (
                  <li class="text-sm leading-snug">
                    <span class="flex items-center gap-2 font-semibold">
                      <span class="size-3 rounded-sm shrink-0" style={`background: ${toene[Math.min(i, toene.length - 1)]}`} aria-hidden="true" />
                      {a.label}
                    </span>
                    <span class="block text-muted mt-0.5">{a.text}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-5 text-[0.95rem] text-muted max-w-prose">
                <strong class="text-ink font-semibold">So fließt das Geld:</strong> Versicherte und Arbeitgeber zahlen Beiträge,
                der Bund gibt einen Zuschuss dazu. Alles landet im Gesundheitsfonds, der es an die Krankenkassen verteilt. Die
                Kassen bezahlen Kliniken, Praxen und Apotheken.
              </p>
              <p class="mt-2 text-xs text-faint">
                Ausgaben der gesetzlichen Krankenversicherung {anteile.stand}, insgesamt {fmt.format(anteilSumme)} {anteile.einheit}
                <SourceRefs ids={[anteile.quelle]} nums={nums} />
              </p>
            </figure>
          )}

          {sd.steuerung.length > 0 && (
            <div class="mb-14">
              <h3 class="serif text-xl font-semibold mb-5">Wer entscheidet was?</h3>
              <ol class="grid md:grid-cols-3 gap-x-8 gap-y-6">
                {sd.steuerung.map((st, i) => (
                  <li class="border-t-2 border-ink pt-3">
                    <span class="serif text-[1.65rem] font-semibold leading-none text-accent">{i + 1}</span>
                    <span class="block font-semibold leading-snug mt-2">{st.titel}</span>
                    <span class="block text-[0.95rem] text-muted mt-1">{st.text}</span>
                    <span class="block text-xs text-faint mt-2">{st.wer}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}

          <div class="grid lg:grid-cols-[1fr_28rem] gap-8 items-start">
            <div>
              <h3 class="serif text-xl font-semibold">Wie die Bereiche zusammenhängen</h3>
              <p class="text-muted mt-2 max-w-prose">
                Jede Linie verbindet zwei Bereiche, deren Fragen sich gegenseitig beeinflussen. Je dicker die Linie, desto
                enger der Zusammenhang.
              </p>
            </div>
            <figure>
              <svg viewBox="-95 15 590 370" class="w-full h-auto" role="img" aria-label="Netz der Zusammenhänge zwischen den Bereichen">
                {[...kanten.entries()].map(([k, n]) => {
                  const [a, b] = k.split('|');
                  const p = pos.get(a!)!;
                  const q = pos.get(b!)!;
                  return (
                    <line
                      x1={p.x}
                      y1={p.y}
                      x2={q.x}
                      y2={q.y}
                      stroke="var(--accent)"
                      stroke-opacity={0.25 + (0.5 * n) / maxKante}
                      stroke-width={1 + (4 * n) / maxKante}
                      stroke-linecap="round"
                    />
                  );
                })}
                {bereiche.map((b) => {
                  const p = pos.get(b.id)!;
                  const cos = Math.cos(p.w);
                  const anchor = Math.abs(cos) < 0.3 ? 'middle' : cos > 0 ? 'start' : 'end';
                  const lx = p.x + 18 * cos;
                  const ly = p.y + 16 * Math.sin(p.w) + (Math.sin(p.w) > 0.3 ? 10 : Math.sin(p.w) < -0.3 ? -4 : 4);
                  return (
                    <a href={`#bereich-${b.id}`}>
                      <circle cx={p.x} cy={p.y} r={6 + Math.min(6, verbindungen(b.id))} fill="var(--bg)" stroke="var(--accent)" stroke-width="2" />
                      <text x={lx} y={ly} text-anchor={anchor} font-size="17" font-weight="600" fill="var(--ink)">
                        {b.data.titel.split(/ & | und /)[0]}
                      </text>
                    </a>
                  );
                })}
              </svg>
            </figure>
          </div>
        </section>
      )
    }

    <!-- Details auf Wunsch -->
    {
      sd && (
        <section class="mt-20 border-t border-line" aria-label="Details">
          <details class="group/d">
            <summary class="flex items-center justify-between gap-4 py-5 cursor-pointer list-none">
              <span>
                <span class="block serif text-xl font-semibold">Alle Zahlen im Detail</span>
                <span class="block text-sm text-muted">
                  {sd.kennzahlen.length} Kennzahlen, {sd.geldfluss.length} Geldströme und {sd.akteure.length} Akteure
                </span>
              </span>
              <span class="text-sm text-accent shrink-0 group-open/d:hidden">aufklappen</span>
              <span class="text-sm text-accent shrink-0 hidden group-open/d:inline">zuklappen</span>
            </summary>

            <div class="pb-6">
              <h3 class="kicker mb-4">Kennzahlen</h3>
              <div class="grid grid-cols-1 min-[420px]:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-6">
                {sd.kennzahlen.map((k) => (
                  <Kennzahl {...k} nums={nums} />
                ))}
              </div>

              <h3 class="kicker mt-12">Alle Geldströme</h3>
              <ol class="border-t border-line mt-3">
                {sd.geldfluss.map((g) => (
                  <li class="border-b border-line py-4 grid gap-1 md:grid-cols-[minmax(0,22rem)_1fr] md:gap-8">
                    <div>
                      <div class="font-semibold leading-snug">
                        {g.von} <span class="text-accent" aria-label="an">→</span> {g.an}
                      </div>
                      <div class="text-accent font-semibold tabular-nums leading-snug mt-0.5">
                        {g.betrag}
                        <SourceRefs ids={[g.quelle]} nums={nums} />
                      </div>
                    </div>
                    <p class="text-sm text-muted leading-snug">{g.text}</p>
                  </li>
                ))}
              </ol>

              <h3 class="kicker mt-12">Alle Akteure</h3>
              <dl class="grid sm:grid-cols-2 gap-x-8 border-t border-line mt-3">
                {sd.akteure.map((a) => (
                  <div class="border-b border-line py-3.5">
                    <dt class="font-semibold">{a.name}</dt>
                    <dd class="text-sm text-muted mt-0.5 leading-snug">{a.rolle}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </details>
        </section>
      )
    }

    {
      sd && (
        <section class="mt-10 border-t border-line pt-6" aria-labelledby="sys-quellen">
          <details>
          <summary class="cursor-pointer list-none kicker mb-3 hover:text-ink" id="sys-quellen">
            Quellen dieser Seite ({quellenSortiert.length}) <span class="normal-case tracking-normal font-normal text-accent">· anzeigen</span>
          </summary>
          {sd.status === 'entwurf' && (
            <div class="mb-4">
              <EntwurfHinweis stand={sd.stand} />
            </div>
          )}
          <ol class="space-y-1.5 text-sm">
            {quellenSortiert.map((q) => (
              <li id={`quelle-${q.id}`} class="grid grid-cols-[2.25rem_1fr] scroll-mt-24">
                <span class="text-faint tabular-nums">[{nums.get(q.id)}]</span>
                <span class="min-w-0">
                  {q.url ? (
                    <a class="link" href={q.url} target="_blank" rel="noopener">
                      {q.titel}
                    </a>
                  ) : (
                    q.titel
                  )}
                  <span class="text-muted"> – {q.herausgeber}, {q.jahr}</span>
                </span>
              </li>
            ))}
          </ol>
          </details>
        </section>
      )
    }
  </div>
</Layout>

<script>
  // Quellenverweise: Ziel in den zugeklappten Details sichtbar machen
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a[href^="#"]');
    if (!a) return;
    const el = document.getElementById(a.getAttribute('href')!.slice(1));
    const details = el?.closest('details');
    if (details && !details.open) details.open = true;
  });
</script>
