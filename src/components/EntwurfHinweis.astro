---
interface Props {
  stand: string;
}
const { stand } = Astro.props;
const datum = new Date(stand).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<div class="rounded-lg px-3 py-2 text-sm" style="background: var(--warn-soft); color: var(--warn-ink)" role="note">
  <strong>Entwurf</strong> – noch nicht redaktionell geprüft. Mit Hilfe eines Sprachmodells recherchiert, Stand {datum}.{' '}
  <a href="/methodik/#entwuerfe" class="underline underline-offset-2">Was heißt das?</a>
</div>
