---
/**
 * Erklärvideo. YouTube-Videos werden erst nach einem Klick geladen (youtube-nocookie),
 * vorher geht keine Anfrage an YouTube. Andere Anbieter erscheinen als Link.
 */
interface Props {
  titel: string;
  absender: string;
  dauer: string;
  jahr?: number | undefined;
  url: string;
  youtube_id?: string | undefined;
}
const { titel, absender, dauer, jahr, url, youtube_id } = Astro.props;
---

<figure class="mb-8">
  {
    youtube_id ? (
      <div class="relative aspect-video bg-ink text-bg" data-video={youtube_id}>
        <button type="button" class="absolute inset-0 w-full h-full flex flex-col items-center justify-center gap-3 cursor-pointer p-4 text-center" data-video-start>
          <span class="size-16 rounded-full border-[3px] border-current grid place-items-center" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="size-7 ml-1" fill="currentColor"><path d="M7 4.5v15l12-7.5z" /></svg>
          </span>
          <span class="font-bold text-lg leading-snug max-w-md">{titel}</span>
          <span class="text-sm opacity-80">Video abspielen · {dauer}</span>
        </button>
      </div>
    ) : (
      <a href={url} target="_blank" rel="noopener" class="flex items-center gap-4 border-2 border-ink p-4 no-underline hover:bg-surface-2">
        <span class="size-12 shrink-0 rounded-full bg-ink text-bg grid place-items-center" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="size-5 ml-0.5" fill="currentColor"><path d="M7 4.5v15l12-7.5z" /></svg>
        </span>
        <span class="min-w-0">
          <span class="block font-bold leading-snug">{titel}</span>
          <span class="block text-sm text-muted">Video bei {absender} · {dauer}</span>
        </span>
      </a>
    )
  }
  <figcaption class="mt-2 text-xs text-muted">
    {absender}{jahr && `, ${jahr}`}.{youtube_id && ' Beim Abspielen lädt YouTube das Video; dabei werden Daten an YouTube übertragen.'}
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((box) => {
    box.querySelector('[data-video-start]')?.addEventListener('click', () => {
      const id = box.dataset.video!;
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      f.title = 'Erklärvideo';
      f.allow = 'autoplay; encrypted-media; picture-in-picture';
      f.allowFullscreen = true;
      f.className = 'absolute inset-0 w-full h-full';
      box.replaceChildren(f);
    });
  });
</script>
