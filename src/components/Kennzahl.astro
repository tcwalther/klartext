---
import SourceRefs from './SourceRefs.astro';
interface Props {
  label: string;
  wert: string;
  stand: string;
  quelle: string;
  hinweis?: string | undefined;
  nums?: Map<string, number>;
}
const { label, wert, stand, quelle, hinweis, nums } = Astro.props;
---

<div class="card p-4 flex flex-col gap-1">
  <div class="text-sm text-muted leading-snug">{label}</div>
  <div class:list={['serif font-semibold leading-tight', wert.length > 16 ? 'text-lg' : 'text-2xl']}>
    {wert}{nums && <SourceRefs ids={[quelle]} nums={nums} />}
  </div>
  <div class="text-xs text-faint">Stand {stand}{hinweis && <> · {hinweis}</>}</div>
</div>
