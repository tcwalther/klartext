---
/**
 * Schlichtes horizontales Balkendiagramm (HTML/CSS, kein JS).
 * Hervorgehobene Werte (meist Deutschland) in Akzentfarbe, Rest grau.
 * Werte stehen direkt am Balken – keine Legende nötig.
 */
import SourceRefs from './SourceRefs.astro';
interface Props {
  titel: string;
  einheit: string;
  stand: string;
  quelle: string;
  hinweis?: string | undefined;
  werte: { label: string; wert: number; hervorheben: boolean }[];
  nums: Map<string, number>;
}
const { titel, einheit, stand, quelle, hinweis, werte, nums } = Astro.props;
const max = Math.max(...werte.map((w) => w.wert));
const fmt = new Intl.NumberFormat('de-DE', { maximumFractionDigits: 1 });
---

<figure class="card p-3 sm:p-5">
  <figcaption class="mb-3">
    <div class="font-semibold leading-snug">{titel}</div>
    <div class="text-xs text-faint">{einheit} · Stand {stand}</div>
  </figcaption>
  <div class="grid grid-cols-1 sm:grid-cols-[minmax(5rem,auto)_minmax(0,1fr)] gap-x-3 gap-y-0.5 sm:gap-y-1.5 items-center text-sm">
    {
      werte.map((w) => (
        <>
          <div class:list={['leading-snug pt-1.5 sm:pt-0 sm:max-w-[14rem]', w.hervorheben ? 'font-semibold' : 'text-muted']}>
            {w.label}
          </div>
          <div class="flex items-center gap-2 min-w-0">
            <div class="flex-1 min-w-0">
              <div
                class="h-4 rounded-r-[4px]"
                style={`width: ${Math.max(1, (w.wert / max) * 100)}%; background: ${w.hervorheben ? 'var(--accent)' : 'var(--line)'}; min-width: 2px;`}
              />
            </div>
            <span class:list={['tabular-nums shrink-0 min-w-[2.5rem] text-right', w.hervorheben && 'font-semibold']}>{fmt.format(w.wert)}</span>
          </div>
        </>
      ))
    }
  </div>
  <div class="mt-3 text-xs text-faint">
    Quelle<SourceRefs ids={[quelle]} nums={nums} />{hinweis && <> · {hinweis}</>}
  </div>
</figure>
