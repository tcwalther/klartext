---
import FeedbackLink from './FeedbackLink.astro';
interface Props {
  n: number;
  id: string;
  titel: string;
  sub: string;
  frageId: string;
  open?: boolean;
}
const { n, id, titel, sub, frageId, open = false } = Astro.props;
---

<details class="ebene group card overflow-hidden" id={id} data-ebene={n} open={open}>
  <summary class="flex items-center gap-3 sm:gap-4 p-4 sm:p-5 hover:bg-surface-2/60">
    <span
      class="shrink-0 size-9 rounded-full grid place-items-center text-sm font-semibold border border-line group-open:bg-accent group-open:text-accent-ink group-open:border-transparent"
      aria-hidden="true">{n}</span
    >
    <span class="flex-1 min-w-0">
      <span class="block serif text-lg font-semibold leading-snug">{titel}</span>
      <span class="block text-sm text-muted leading-snug">{sub}</span>
    </span>
    <svg class="chev shrink-0 size-5 text-faint" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M7.5 4.5 13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </summary>
  <div class="px-4 sm:px-5 pb-5 pt-1 sm:pl-[4.25rem]">
    <slot />
    <div class="mt-5 pt-3 border-t border-line flex flex-wrap gap-x-4 gap-y-1 items-center justify-between">
      <a href={`#${id}`} class="text-xs text-faint hover:text-ink no-underline">Link zu dieser Ebene</a>
      <FeedbackLink abschnitt={`${frageId}#${id}`} />
    </div>
  </div>
</details>
