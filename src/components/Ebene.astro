---
/**
 * Eine Ebene der Zwiebel – als Kapitel, nicht als Kasten:
 * Linie oben, große Ziffer, Titel. Tiefer liegende Ebenen werden typografisch dichter.
 */
import FeedbackLink from './FeedbackLink.astro';
interface Props {
  n: number;
  id: string;
  titel: string;
  sub?: string;
  frageId: string;
  open?: boolean;
}
const { n, id, titel, sub, frageId, open = false } = Astro.props;
---

<details class="ebene group border-t border-line open:border-ink/70 scroll-mt-28 lg:scroll-mt-20" id={id} data-ebene={n} open={open}>
  <summary class="flex items-start gap-3 sm:gap-4 py-4 sm:py-5 cursor-pointer hover:[&_.ebene-titel]:text-accent">
    <span
      class="serif shrink-0 w-7 text-[1.65rem] leading-none font-semibold tabular-nums text-faint group-open:text-accent pt-0.5"
      aria-hidden="true">{n}</span
    >
    <span class="flex-1 min-w-0">
      <span class="ebene-titel block serif text-xl font-semibold leading-snug transition-colors">{titel}</span>
      {sub && <span class="block text-sm text-muted leading-snug mt-0.5">{sub}</span>}
    </span>
    <svg class="chev shrink-0 size-5 text-faint mt-1" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M7.5 4.5 13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </summary>
  <div class="ebene-body pb-8 sm:pl-11">
    <slot />
    <div class="mt-6 flex justify-end empty:hidden">
      <FeedbackLink abschnitt={`${frageId}#${id}`} />
    </div>
  </div>
</details>
