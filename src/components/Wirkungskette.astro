---
/**
 * Wirkungskette als nummerierte Stufen entlang einer Linie (von oben nach unten).
 * Innerhalb einer Stufe stehen die Punkte nebeneinander. Keine Kästen.
 */
import { md } from '../lib/content';
interface Props {
  stufen: { titel: string; punkte: { label: string; text: string }[] }[];
}
const { stufen } = Astro.props;
---

<figure aria-label="Wirkungskette">
  <ol class="relative">
    {
      stufen.map((s, i) => (
        <li class="relative pl-10 pb-6 last:pb-0">
          {i < stufen.length - 1 && <span class="absolute left-[0.8rem] top-7 bottom-0 w-px bg-accent/40" aria-hidden="true" />}
          <span
            class="absolute left-0 top-0 size-[1.65rem] rounded-full grid place-items-center text-xs font-bold bg-accent text-accent-ink"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <div class="kicker text-accent pt-1 mb-2">{s.titel}</div>
          <ul class:list={['grid gap-x-6 gap-y-3', s.punkte.length > 1 && 'sm:grid-cols-2']}>
            {s.punkte.map((p) => (
              <li class="text-[0.95rem] leading-snug">
                <span class="font-semibold">{p.label}</span>
                <span class="block text-muted prose-k" set:html={md(p.text)} />
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</figure>
