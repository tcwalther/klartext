---
/**
 * Wirkungskette in Stufen (z. B. Treiber → Ausgaben → Lücke → Stellschrauben).
 * Immer von oben nach unten; innerhalb einer Stufe stehen die Punkte nebeneinander.
 * So bleibt sie bei jeder Stufenzahl und Bildschirmbreite lesbar.
 */
import { md } from '../lib/content';
interface Props {
  stufen: { titel: string; punkte: { label: string; text: string }[] }[];
}
const { stufen } = Astro.props;
---

<figure aria-label="Wirkungskette">
  <ol class="grid gap-0">
    {
      stufen.map((s, i) => (
        <li>
          <div class="rounded-xl border border-line bg-surface p-3 sm:p-4">
            <div class="flex items-center gap-2 mb-2.5">
              <span
                class="size-6 shrink-0 rounded-full grid place-items-center text-xs font-semibold bg-accent text-accent-ink"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <span class="text-xs font-semibold uppercase tracking-wide text-accent">{s.titel}</span>
            </div>
            <ul class:list={['grid gap-x-5 gap-y-2.5', s.punkte.length > 1 && 'sm:grid-cols-2', s.punkte.length > 2 && 'lg:grid-cols-3']}>
              {s.punkte.map((p) => (
                <li class="text-sm leading-snug min-w-0 hyphens-auto break-words" lang="de">
                  <span class="font-semibold">{p.label}</span>
                  <span class="block text-muted prose-k" set:html={md(p.text)} />
                </li>
              ))}
            </ul>
          </div>
          {i < stufen.length - 1 && (
            <div class="grid place-items-center text-accent leading-none py-1" aria-hidden="true">
              ↓
            </div>
          )}
        </li>
      ))
    }
  </ol>
</figure>
