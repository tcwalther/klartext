---
import SourceRefs from './SourceRefs.astro';
import { md, typLabel, typErklaerung, type Aussage } from '../lib/content';
interface Props {
  a: Aussage;
  nums: Map<string, number>;
  as?: 'li' | 'p' | 'div';
}
const { a, nums, as: Tag = 'li' } = Astro.props;
// „**Etikett:** Text“ → Etikett als eigene Zeile über der Aussage (statt fettem Doppelpunkt-Präfix im Fließtext)
const m = a.text.match(/^\*\*([^*]+?):\*\*\s*/);
const etikett = m ? m[1] : null;
const text = m ? a.text.slice(m[0].length) : a.text;
---

<Tag class={`aussage aussage-${a.typ} leading-relaxed`} title={`${typLabel[a.typ]}: ${typErklaerung[a.typ]}`}>
  <span class="sr-only">{typLabel[a.typ]}{a.wer && ` von ${a.wer}`}: </span>
  {etikett && <span class="block font-semibold leading-snug mb-0.5">{etikett}</span>}
  <span class="aussage-text prose-k" set:html={md(text)} /><SourceRefs ids={a.quellen} nums={nums} />
  {a.typ === 'position' && a.wer && <span class="aussage-wer" aria-hidden="true">— {a.wer}</span>}
  {
    a.genau && (
      <details class="genau mt-1.5 text-sm">
        <summary class="cursor-pointer text-accent select-none w-fit">Genaue Zahlen</summary>
        <div class="mt-1 rounded-md bg-surface-2 px-3 py-2 text-muted prose-k" set:html={md(a.genau)} />
      </details>
    )
  }
  {
    a.unsicherheit && (
      <span class="block mt-1 text-sm text-muted">
        <span class="font-semibold">Unsicherheit:</span> {a.unsicherheit}
      </span>
    )
  }
</Tag>
